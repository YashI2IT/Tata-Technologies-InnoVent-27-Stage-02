# ========================
# AeroEdge-X Environment Configuration
# ========================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.

# Flask Configuration
FLASK_CONFIG=development
FLASK_DEBUG=1
SECRET_KEY=your-unique-secret-key-here

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7860
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Data Directories
DATABASE_PATH=database/digital_twin.db
UPLOAD_DIR=uploads
REPORT_DIR=reports
MANUALS_DIR=manuals
CHROMA_DIR=data/chroma

# AI Models
MODEL_PATH=models/best.pt
VISION_AGENT_MODE=local
JETSON_URL=http://127.0.0.1:8000
JETSON_TIMEOUT_SECONDS=30
VISION_CONFIDENCE_THRESHOLD=0.40

# Local LLM (Ollama)
LLM_MODEL=phi3:mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO

# AWS Cloud Synchronization
AEROEDGE_DEVICE_ID=AEROEDGE-DESKTOP-001
AWS_REGION=us-east-1
AWS_API_URL=
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=AeroEdge-Inspections
AWS_SYNC_INTERVAL_SECONDS=30
