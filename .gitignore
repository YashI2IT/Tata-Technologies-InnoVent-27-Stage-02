# ========================
# AeroEdge-X .gitignore
# ========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
tests/fixtures/test_digital_twin.db*
tests/fixtures/uploads/*
tests/fixtures/reports/*
test_data/
!tests/fixtures/.gitkeep

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-electron/
frontend/build/
frontend/release/
frontend/.env
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Electron build output
win-unpacked/

# Databases
*.db
*.sqlite
*.sqlite3
data/chroma/
database/*.db

# Runtime generated files
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# Installers and binaries
*.exe
*.msi
*.zip
installer/output/

# Large model files (use Git LFS or download instructions)
# models/best.pt
# models/all-MiniLM-L6-v2/

# OS / Editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Generated artifacts
audit.txt
tree.txt
test_report.pdf